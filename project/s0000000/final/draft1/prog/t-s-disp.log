MPRINT(MK_T_S_DISP):   * Continuing;
MPRINT(MK_T_S_DISP):   if (comsfl eq 'Y') then comsfl_n = 2;
MPRINT(MK_T_S_DISP):   * Completed;
MPRINT(MK_T_S_DISP):   if (comsfl eq 'N') or (comsfl = '' and dcsreas ne '') then comsfl_n = 3;
