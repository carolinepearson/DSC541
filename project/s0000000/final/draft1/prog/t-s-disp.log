MPRINT(TABCOUNT):   data _tabptc7 (keep = dcsreas start linlabel value1 - value3 statord1 - statord1 pctx1 - pctx3);
MPRINT(TABCOUNT):   set _tabptc3;
MPRINT(TABCOUNT):   by dcsreas start linlabel notsorted;
MPRINT(TABCOUNT):   length value1- value3 $40 statord1 - statord1 $40 pctx1 - pctx3 $10 pctx_n1 - pctx_n3 8 __temp 8;
MPRINT(TABCOUNT):   *kchan07 2016-11-1;
MPRINT(TABCOUNT):   length statval $ 40;
MPRINT(TABCOUNT):   array outval {*} $ value1 - value3;
MPRINT(TABCOUNT):   array outpct {*} $ pctx1 - pctx3;
MPRINT(TABCOUNT):   array __pn {*} pctx_n1 - pctx_n3;
MPRINT(TABCOUNT):   *kchan07 2016-11-1;
MPRINT(TABCOUNT):   retain value1 - value3 totn pctx1 - pctx3;
MPRINT(TABCOUNT):   statord1 = ' ';
MPRINT(TABCOUNT):   if first.linlabel then do;
MPRINT(TABCOUNT):   totn = 0;
MPRINT(TABCOUNT):   do i = 1 to 3;
MPRINT(TABCOUNT):   outval{i} = ' ';
MPRINT(TABCOUNT):   outpct{i} = ' ';
MPRINT(TABCOUNT):   end;
MPRINT(TABCOUNT):   end;
MPRINT(TABCOUNT):   statval = ' ';
MPRINT(TABCOUNT):   if _freq_ = . then _freq_ = 0;
MPRINT(TABCOUNT):   statval = put(_freq_, 3. );
MPRINT(TABCOUNT):   len = length(statval);
MPRINT(TABCOUNT):   *if pct&__I = . then do;
MPRINT(TABCOUNT):   ** kdaughtry 07Oct08 - if count=0, then pct=0 **;
MPRINT(TABCOUNT):   *pct&__I = 0;
MPRINT(TABCOUNT):   *percent = 0;
MPRINT(TABCOUNT):   *end;
MPRINT(TABCOUNT):   if 0 < pct1 < 0.1 then do;
MPRINT(TABCOUNT):   statval = substr(statval,1,len) || " ( <0.1%)";
MPRINT(TABCOUNT):   percent = pct1;
                                                                    The SAS System

MPRINT(TABCOUNT):   end;
MPRINT(TABCOUNT):   else do;
MPRINT(TABCOUNT):   if pct1 ne . then percent = round(pct1,0.1);
MPRINT(TABCOUNT):   if percent>0 then statval = substr(statval,1,len) || " (" || put(percent,5.1) || "%)";
MPRINT(TABCOUNT):   else statval= substr(statval,1,len);
MPRINT(TABCOUNT):   end;
MPRINT(TABCOUNT):   drop len;
MPRINT(TABCOUNT):   *if (totn=.) then totn = _freq_;
MPRINT(TABCOUNT):   *else if (_freq_>.) then totn = totn + _freq_;
MPRINT(TABCOUNT):   totn=sum(totn, _freq_);
MPRINT(TABCOUNT):   *klc 27may2015;
MPRINT(TABCOUNT):   outval{trt01pn} = statval;
MPRINT(TABCOUNT):   __pn{trt01pn} = percent;
MPRINT(TABCOUNT):   *kchan07 2016-11-1;
MPRINT(TABCOUNT):   outpct{trt01pn} = compress(put(percent,best.));
MPRINT(TABCOUNT):   if last.linlabel then do;
MPRINT(TABCOUNT):   if "F" = "F" then statord1 = put(1000000-totn,z7.);
MPRINT(TABCOUNT):   if "F" = "A" then statord1 = ' ';
MPRINT(TABCOUNT):   if "F" = "I" then statord1 = start;
MPRINT(TABCOUNT):   if "F" = "M" then do;
MPRINT(TABCOUNT):   __temp=pctx_n1;
MPRINT(TABCOUNT):   __temp = max(of pctx_n1 - pctx_n2);
MPRINT(TABCOUNT):   statord1=compress(put(__temp,z9.5));
MPRINT(TABCOUNT):   end;
MPRINT(TABCOUNT):   if "F" = "T" then statord1 = put(percent,6.2);
MPRINT(TABCOUNT):   output;
MPRINT(TABCOUNT):   end;
