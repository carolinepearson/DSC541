MPRINT(TXT2PDF):   data _null_;
MPRINT(TXT2PDF):   retain firstobs 1;
MPRINT(TXT2PDF):   infile "t-s-disp.out" pad end=eof;
MPRINT(TXT2PDF):   input char $char1.;
MPRINT(TXT2PDF):   if _n_ = 1 then do;
MPRINT(TXT2PDF):   pages + 1;
MPRINT(TXT2PDF):   if char="1b"x then do;
MPRINT(TXT2PDF):   firstobs = 2;
MPRINT(TXT2PDF):   return;
MPRINT(TXT2PDF):   end;
MPRINT(TXT2PDF):   end;
MPRINT(TXT2PDF):   totlines + 1;
MPRINT(TXT2PDF):   if char = "0c"x then pages + 1;
MPRINT(TXT2PDF):   else if char = "1b"x then do;
MPRINT(TXT2PDF):   pages + 1;
MPRINT(TXT2PDF):   totlines + -1;
MPRINT(TXT2PDF):   end;
MPRINT(TXT2PDF):   if eof then do;
MPRINT(TXT2PDF):   if (pages < totlines/48) then do;
MPRINT(TXT2PDF):   pagemode = "fixed   ";
MPRINT(TXT2PDF):   pages = ceil(totlines/48);
MPRINT(TXT2PDF):   end;
MPRINT(TXT2PDF):   else pagemode = "standard";
MPRINT(TXT2PDF):   call symput("pagemode", trim(pagemode));
MPRINT(TXT2PDF):   call symput("pages", compress(put(pages,8.)));
MPRINT(TXT2PDF):   call symput("firstobs", put(firstobs,1.));
MPRINT(TXT2PDF):   call symput("totlines", put(totlines,8.));
                                                                    The SAS System

MPRINT(TXT2PDF):   createtm = compress(put(time(),time8.),":");
MPRINT(TXT2PDF):   createtm = translate(createtm,"0"," ");
MPRINT(TXT2PDF):   call symput("createdt", put(date(),yymmddn8.)||substr(createtm,1,8));
MPRINT(TXT2PDF):   * put "NOTE: %&sysmacroname Version &toolver: " "page counter diagnostics " / " " pagemode= pages= firstobs= totlines= createtm=;
MPRINT(TXT2PDF):   stop;
MPRINT(TXT2PDF):   end;
MPRINT(TXT2PDF):   run;

