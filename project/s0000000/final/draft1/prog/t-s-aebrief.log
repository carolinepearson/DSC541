MPRINT(TXT2PDF):   if substr(text,1,1) in ("0c"x,"1b"x) or _n_ = 1 or mod(lines,48)=0 then link toppage;
MPRINT(TXT2PDF):   ** Modify text for proper inclusion in PDF **;
MPRINT(TXT2PDF):   if indexc(text,"0d0cc4"x,"\()") then do;
MPRINT(TXT2PDF):   text = compress(text,"0d0c"x);
MPRINT(TXT2PDF):   text = translate(text,"-","c4"x);
MPRINT(TXT2PDF):   text = tranwrd(text,"\","\\");
MPRINT(TXT2PDF):   text = tranwrd(text,"(","\(");
MPRINT(TXT2PDF):   text = tranwrd(text,")","\)");
MPRINT(TXT2PDF):   end;
MPRINT(TXT2PDF):   ** Store text for later writing **;
MPRINT(TXT2PDF):   lines + 1;
MPRINT(TXT2PDF):   line{lines} = "("||trim(text)||")'";
MPRINT(TXT2PDF):   pagesize + length(line{lines})+crlf;
MPRINT(TXT2PDF):   ** File termination routine **;
MPRINT(TXT2PDF):   if eof then do;
MPRINT(TXT2PDF):   link endpage;
MPRINT(TXT2PDF):   strtxref = bytecnt;
MPRINT(TXT2PDF):   temptxt = "xref";
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   temptxt = "0 "||compress(put(objnum+1,8.));
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   temptxt = "0000000000 65535 f";
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   do i = 1 to objnum;
MPRINT(TXT2PDF):   temptxt = put(objbyte{i},z10.)||" 00000 n";
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   end;
MPRINT(TXT2PDF):   temptxt = "trailer << /Size "||compress(put(objnum+1,8.))|| " /Info 1 0 R /Root 2 0 R >>";
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   temptxt = "startxref";
                                                                    The SAS System

MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   temptxt = compress(put(strtxref,12.));
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   temptxt = '%%EOF';
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   stop;
MPRINT(TXT2PDF):   end;
MPRINT(TXT2PDF):   return;
MPRINT(TXT2PDF):   ** Beginning of page routine **;
MPRINT(TXT2PDF):   toppage: if substr(text,1,1) = "1b"x then input text $char200.;
MPRINT(TXT2PDF):   if _n_ gt 1 then link endpage;
MPRINT(TXT2PDF):   temptxt = compress(put(objnum+1,8.))|| " 0 obj << /Type /Page /Parent 6 0 R /Resources";
MPRINT(TXT2PDF):   isobj = 1;
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   temptxt = "<< /Font << /F1 4 0 R >> /ProcSet 5 0 R >>";
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   temptxt = "/MediaBox [ 0 0 792 612 ] /Contents " || compress(put(objnum+1,8.)) || " 0 R >> endobj";
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   lines = 0;
MPRINT(TXT2PDF):   return;
MPRINT(TXT2PDF):   ** End of page routine - write out one full page worth of text **;
MPRINT(TXT2PDF):   endpage: setup = "BT /F1 7 Tf 10 TL 72 540 Td";
MPRINT(TXT2PDF):   temptxt = compress(put(objnum+1,8.)) || " 0 obj << /Length "|| compress(put(pagesize+length(setup)+length(follow)+crlf,8.))||" >>";
MPRINT(TXT2PDF):   isobj = 1;
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   temptxt = "stream";
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   temptxt = setup;
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   do i = 1 to lines;
MPRINT(TXT2PDF):   temptxt = line{i};
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   end;
MPRINT(TXT2PDF):   temptxt = follow;
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   temptxt = "endstream";
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   temptxt = "endobj";
MPRINT(TXT2PDF):   link puttxt;
MPRINT(TXT2PDF):   pagesize = 0;
MPRINT(TXT2PDF):   return;
MPRINT(TXT2PDF):   ** Write text and accumulate byte count routine **;
MPRINT(TXT2PDF):   puttxt: textlen = length(temptxt);
MPRINT(TXT2PDF):   if isobj then do;
MPRINT(TXT2PDF):   isobj = 0;
MPRINT(TXT2PDF):   objnum + 1;
