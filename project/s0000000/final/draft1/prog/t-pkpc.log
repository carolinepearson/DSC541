1209      +
1210      +data pc1;
1211      +   set pc0;
1212      +   where upcase(pkfl) = 'Y';
1213      +   /* %pkconc's PKVAR= parameter requires a numeric 0/1 WHERE-filter variable - ADPC/ADSL only
1214      +      carry PKFL as character Y/N, so derive the numeric flag it expects. Every record here has
1215      +      already been subset to the PK Analysis Set above, so the flag is always 1. */
1216      +   pkflag = 1;
1217      +   /* %m_pkconc_new hardcodes the LITERAL column name "hour" (not the &hour macro variable) in
1218      +      an internal PROC SQL join (stats&excl <- aclm on a.hour=b.hour) - passing hour=atptn alone
1219      +      leaves that join referencing a nonexistent "hour" column and crashes ("Column hour could
1220      +      not be found"), so the caller's hour variable must literally be named HOUR. */
1221      +   hour = atptn;
1222      +   /* Dummy day placeholder - PCDY has multiple distinct values across the PK population, which
1223      +      is not what DAY= is for here (single Day-1 serial PK sampling); a constant dummy avoids
1224      +      that without relying on %m_pkconc_new's own blank-day auto-creation (see day= below). */
1225      +   pkday = 1;
1226      +   /* %m_pkconc_new's internal m_pk_header callback (used to suppress a repeated "Participant ID"
1227      +      header on summary-stat pages) detects listing rows via prxmatch("/\d+-\d+/",...) against
1228      +      the displayed PTVAR value - plain SUBJID (e.g. "002") has no dash and never matches, so the
1229      +      header was blanked on every page, including real listing pages. SITEID-SUBJID is a standard
1230      +      site-subject display id, is short, and satisfies that pattern. */
1231      +   ptid = strip(siteid) || '-' || strip(subjid);
1232      +run;
1233      +
1234      +%nobs(pc1);
1235      +%m_val_log(titlekey=&titlekey, dsname=adpc, varname=pkfl, check=Population record count,
1236      +           expected=>0 PK Analysis Set concentration records, actual=&nobs,
1237      +           status=%sysfunc(ifc(&nobs>0,PASS,ERROR)), message=PK Analysis Set record count.);
1238      +
1239      +%if &nobs = 0 %then %do;
1240      +   %let &statvar._status = ERROR;
1241      +   %goto endprogram;
1242      +%end;
1243      +
1244      +/* %pkconc's own default hour-header logic (no hrfmt= given) shows "Pre-dose" for hour=0 and the
1245      +   bare number (no unit) for every other timepoint - build a format, from the ATPTN values
1246      +   actually present, that appends "h" to every non-zero timepoint while leaving Pre-dose as-is. */
1247      +proc sql noprint;
1248      +   create table _hrfmt_cntl as
1249      +      select distinct hour as start,
1250      +             ifc(hour = 0, 'Pre-dose', cats(put(hour, best.), 'h')) as label length=20,
1251      +             'hrfmt' as fmtname length=8,
                                                                    The SAS System

1252      +             'N' as type length=1
1253      +      from pc1;
1254      +quit;
1255      +
1256      +proc format cntlin=_hrfmt_cntl;
1257      +run;
1258      +
1259      +/* %pkconc subsets internally on WHERE UPCASE(&analvar)="&analyte" - determine the single
1260      +   analyte value present in the data dynamically rather than hard-coding the tnf.inc footnote's
1261      +   placeholder text ("GS-XXXX"). */
1262      +proc sql noprint;
1263      +   select count(distinct param) into :_nanalyte trimmed from pc1;
1264      +   select distinct param into :analyte1-:analyte99 from pc1;
1265      +quit;
1266      +
1267      +%if &_nanalyte ne 1 %then %do;
1268      +   %m_val_log(titlekey=&titlekey, dsname=adpc, varname=param, check=Single-analyte assumption,
1269      +              expected=Exactly 1 distinct PARAM value, actual=&_nanalyte,
1270      +              status=%sysfunc(ifc(&_nanalyte>0,WARNING,ERROR)),
1271      +              message=%str(%%)pkconc requires one ANALYTE value per call - using the first distinct
1272      +PARAM value found (&analyte1). Re-verify if more than one analyte is expected in this table.);
1273      +%end;
1274      +
1275      +%if &_nanalyte = 0 %then %do;
1276      +   %let &statvar._status = ERROR;
1277      +   %goto endprogram;
1278      +%end;
1279      +
1280      +/*------------------------------------------------------------------------------------------*
1281      + | Render exactly one PDF: t-pkpc.pdf, via the global macro %m_pkconc_new.                    |
1282      + | ptvar/trt/hour/conc/analvar reference ADPC's own column names directly (no renaming);      |
1283      + | CONCN is left blank so %m_pkconc_new derives it from CONC itself, applying its own BLQ->0   |
1284      + | logic (tnf.inc footnote 2) automatically. GMEAN/GCILOW/GCIUPP request the geometric-mean    |
1285      + | 95% CI (T-distribution) that the shell JSON's "95% CI (Lower)/(Upper)" rows call for.       |
1286      + *------------------------------------------------------------------------------------------*/
1287      +%m_pkconc_new(data      = pc1,
1288      +        ptvar     = ptid, /* SITEID-SUBJID - see the pc1 data step comment for why bare SUBJID
1289      +                             breaks the macro's own "Participant ID" header-repeat suppression */
1290      +        col1hdr   = %str(Participant ID),
1291      +        col1wdh   = 16, /* default is 30 - far wider than a short site-subject id needs */
1292      +        pkvar     = pkflag,
1293      +        titlekey  = &titlekey,
1294      +        outname   = &outname,
1295      +        analyte   = &analyte1,
1296      +        analvar   = param,
1297      +        trt       = trt01pn,
                                                                    The SAS System

1298      +        trtfmt    = trtfmt,
1299      +        day       = pkday, /* constant dummy day - leaving day= blank relies on %m_pkconc_new's
1300      +                             own dummy-day auto-creation, which does not patch every internal
1301      +                             dataset and crashes with "Variable DAY not found"; PCDY was tried
1302      +                             instead but has multiple distinct values across the PK population,
1303      +                             which is not what DAY= is for with single Day-1 serial PK sampling */
1304      +        hour      = hour, /* must literally be named HOUR - see the pc1 data step comment */
1305      +        hrfmt     = hrfmt, /* appends "h" to each non-zero timepoint header (e.g. "1h", "2h"),
1306      +                               keeping "Pre-dose" as-is - see the CNTLIN-built format above */
1307      +        conc      = avalc,
1308      +        concn     = , /* must be explicitly blanked - the macro's own default is "concn", not
1309      +                          blank, so omitting this entirely does NOT trigger auto-derivation */
1310      +        dp        = 2,
1311      +        dist      = T,
1312      +		alpha_a   =0.05,      /** For arithmetic mean: 0.05 for 95% confidence interval and 0.1 for 90% confidence interval **/
1313      + 		alpha_g   =0.05,      /** For geometric mean: 0.05 for 95% confidence interval and 0.1 for 90% confidence interval **/
1314      +		clm       = Y,             /** Want to show lower and upper confidence interval limits for arithmetic mean? **/
1315      +        gn        = Y,
1316      +        gmean     = Y,
1317      +        gcv		  = Y,           /** Want Geom CV presented on output or not (default=N) - O **/        gcilow    = Y,
1318      +        gciupp    = Y,
1319      +        spanhdr   = Sampling Time (h),
1320      +        trttitl   = Treatment,
1321      +        wantintext= N,
1322      +        vdata     = vdata); /* the study's vdata libref, auto-assigned by the gsub job wrapper -
1323      +                               matches the working reference program's usage (t-pkconc-gs1614.sas
1324      +                               passes vdata=vdata); leaving this blank is not what any confirmed
1325      +                               working %m_pkconc_new caller does */
1326      +
1327      +%endprogram:
1328      +
1329      +
1330      +%mend main;
1331      +
1332      +%main;
