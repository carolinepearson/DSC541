MPRINT(TABDCAT):   ds = open("analf","i");
MPRINT(TABDCAT):   var = varnum(ds , "comt01n");
MPRINT(TABDCAT):   if not(var) then do;
MPRINT(TABDCAT):   call symput("_errcode","F");
MPRINT(TABDCAT):   call symput("_errmsg","Categorical analysis variable comt01n .does not. exist - canceling run" );
MPRINT(TABDCAT):   end;
MPRINT(TABDCAT):   else do;
MPRINT(TABDCAT):   call symput("catvfmt",varfmt(ds,var));
MPRINT(TABDCAT):   label1 = varlabel(ds,var);
MPRINT(TABDCAT):   if index(label1,'~') > 0 then do;
MPRINT(TABDCAT):   label2 = scan(label1,2,'~');
MPRINT(TABDCAT):   label1 = scan(label1,1,'~');
MPRINT(TABDCAT):   end;
MPRINT(TABDCAT):   call symput("label1",label1);
MPRINT(TABDCAT):   call symput("label2",label2);
MPRINT(TABDCAT):   typ = vartype(ds,var);
MPRINT(TABDCAT):   call symput("type",typ);
MPRINT(TABDCAT):   end;
MPRINT(TABDCAT):   run;

