MPRINT(TABDCAT):   set _tabcat7;
MPRINT(TABDCAT):   sortord=5;
MPRINT(TABDCAT):   label1="Study Drug Completion Status                                                                                               
                                                                                                                               ";
MPRINT(TABDCAT):   label2="                                                                                                                           
                                                                    The SAS System

                                                                                                                               ";
MPRINT(TABDCAT):   type = "CAT ";
MPRINT(TABDCAT):   statord = left(start);
MPRINT(TABDCAT):   array vl {*} value1 - value3;
MPRINT(TABDCAT):   if trim(start) eq '.' or start = ' ' then delete;
MPRINT(TABDCAT):   if trim(linlabel) = '- Missing -' then statord = '999999999';
MPRINT(TABDCAT):   vct = 0;
MPRINT(TABDCAT):   do i = 1 to 3;
MPRINT(TABDCAT):   if vl{i} = ' ' and substr(linlabel,1,10) ^= 'Risk Ratio' then do;
MPRINT(TABDCAT):   vl{i} = put(0, 3. );
MPRINT(TABDCAT):   len = length(vl{i});
MPRINT(TABDCAT):   * vl{i} = substr(vl{i},1,len) || " (" || put(0,&pctfmt) || "%)";
MPRINT(TABDCAT):   if "Y" = 'Y' and statord = '999999999' then do;
MPRINT(TABDCAT):   vl{i} = put(0, 3. );
MPRINT(TABDCAT):   end;
MPRINT(TABDCAT):   end;
MPRINT(TABDCAT):   *** Reset intentionally set "No CI" back to blank ***;
MPRINT(TABDCAT):   *** if all blank then delete ***;
MPRINT(TABDCAT):   if vl{i} = "No CI" then do;
MPRINT(TABDCAT):   vl{i} = " ";
MPRINT(TABDCAT):   vct + 1;
MPRINT(TABDCAT):   end;
MPRINT(TABDCAT):   end;
MPRINT(TABDCAT):   if vct = 3 then delete;
MPRINT(TABDCAT):   drop i vct len ;
MPRINT(TABDCAT):   * &var;
MPRINT(TABDCAT):   run;

