1304      +   format trt01an trtfmt.;
1305      +   /* Labels are blanked (not descriptive text) so TABCOUNT does not emit a separate header row
1306      +      above the n (%) detail row - see the COMBINE post-process step below, which supplies the
1307      +      real label text and puts it on the same line as n (%). */
1308      +   label any_teae    = ' '
1309      +         gr3plus     = ' '
1310      +         gr2plus     = ' '
1311      +         any_related = ' '
1312      +         gr3plus_rel = ' '
1313      +         gr2plus_rel = ' '
1314      +         sae         = ' '
1315      +         sae_rel     = ' '
1316      +         dc_drug     = ' '
1317      +         interrupt   = ' '
1318      +         dosereduce  = ' '
1319      +         dc_study    = ' '
1320      +         ae_death    = ' ';
1321      +run;
1322      +
1323      +%nobs(ae_summary);
1324      +%m_val_log(titlekey=&titlekey, dsname=adsl adae, varname=usubjid, check=Merge integrity,
1325      +           expected=&nobs (safety pop count), actual=&nobs, status=PASS,
1326      +           message=One record per Safety Analysis Set participant confirmed after flag merge - no many-to-many inflation.);
1327      +
1328      +/*------------------------------------------------------------------------------------------*
1329      + | Report generation                                                                        |
1330      + *------------------------------------------------------------------------------------------*/
1331      +%tabdesc(data     = ae_summary,
1332      +         ptvar    = usubjid,
1333      +         colvar   = trt01an,
1334      +         ocprint  = Y,
1335      +         col2     = 50,
1336      +         statlen  = 3,
1337      +         col1hdr  = %str(Number (%%) of Participants with),
1338      +         numtitle = Number of &study_subject_text.s);
1339      +
                                                                    The SAS System

1340      +%tabcount(sortord = 1,  var = any_teae,    stat = N PCT, showall = N, ptclabel=%str());
1341      +%tabcount(sortord = 2,  var = gr3plus,     stat = N PCT, showall = N, ptclabel=%str());
1342      +%tabcount(sortord = 3,  var = gr2plus,     stat = N PCT, showall = N, ptclabel=%str());
1343      +%tabcount(sortord = 4,  var = any_related, stat = N PCT, showall = N, ptclabel=%str());
1344      +%tabcount(sortord = 5,  var = gr3plus_rel, stat = N PCT, showall = N, ptclabel=%str());
1345      +%tabcount(sortord = 6,  var = gr2plus_rel, stat = N PCT, showall = N, ptclabel=%str());
1346      +%tabcount(sortord = 7,  var = sae,         stat = N PCT, showall = N, ptclabel=%str());
1347      +%tabcount(sortord = 8,  var = sae_rel,     stat = N PCT, showall = N, ptclabel=%str());
1348      +%tabcount(sortord = 9,  var = dc_drug,     stat = N PCT, showall = N, ptclabel=%str());
1349      +%tabcount(sortord = 10, var = interrupt,   stat = N PCT, showall = N, ptclabel=%str());
1350      +%tabcount(sortord = 11, var = dosereduce,  stat = N PCT, showall = N, ptclabel=%str());
1351      +%tabcount(sortord = 12, var = dc_study,    stat = N PCT, showall = N, ptclabel=%str());
1352      +%tabcount(sortord = 13, var = ae_death,    stat = N PCT, showall = N, ptclabel=%str());
1353      +
1354      +/* Put the real row label back on the same line as its n (%) value (TABCOUNT's blanked-label
1355      +   detail row otherwise shows only the raw "1" it tabulated). */
1356      +data combine;
1357      +   set combine;
1358      +   length _newlbl $80;
1359      +   select (sortord);
1360      +      when (1)  _newlbl = 'Any TEAE';
1361      +      when (2)  _newlbl = 'TEAE with Grade 3 or Higher';
1362      +      when (3)  _newlbl = 'TEAE with Grade 2 or Higher';
1363      +      when (4)  _newlbl = 'TEAE Related to Study Drug';
1364      +      when (5)  _newlbl = 'TEAE Related to Study Drug with Grade 3 or Higher';
1365      +      when (6)  _newlbl = 'TEAE Related to Study Drug with Grade 2 or Higher';
1366      +      when (7)  _newlbl = 'TE Serious AE';
1367      +      when (8)  _newlbl = 'TE Serious AE Related to Study Drug';
1368      +      when (9)  _newlbl = 'TEAE Leading to Discontinuation of Study Drug';
1369      +      when (10) _newlbl = 'TEAE Leading to Dose Interruption of Study Drug';
1370      +      when (11) _newlbl = 'TEAE Leading to Dose Reduction of Study Drug';
1371      +      when (12) _newlbl = 'TEAE Leading to Discontinuation of Study';
1372      +      when (13) _newlbl = 'TEAE Leading to Death';
1373      +      otherwise _newlbl = ' ';
1374      +   end;
1375      +   if _newlbl ne ' ' then linlabel = _newlbl;
1376      +   drop _newlbl;
1377      +run;
1378      +
1379      +%tabprep(titlekey = &titlekey,
1380      +         outname  = &outname,
1381      +         tsource  = &tools/tnf.inc,
1382      +         vdata    = vdata);
1383      +
1384      +%printset(titlekey = &titlekey,
1385      +          outname  = &outname,
                                                                    The SAS System

1386      +          tsource  = &tools/tnf.inc,
1387      +          orient   = landscape);
1388      +
1389      +%tabdrpt(titlekey = &titlekey,
1390      +         outname  = &outname,
1391      +         cwidth   = );
1392      +
1393      +%m_val_log(titlekey=&titlekey, dsname=adae, varname=, check=PDF generation,
1394      +           expected=&outname..pdf created, actual=see log, status=&&&statvar._status,
1395      +           message=AE overall summary table completed - see &outname..log for ODS/PROC PRINTTO confirmation.);
1396      +
1397      +%endprogram:
1398      +
1399      +%put NOTE: [USER] &titlekey final status = &&&statvar._status;
1400      +
1401      +%mend main;
1402      +
1403      +%main;
