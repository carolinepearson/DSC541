MPRINT(TABCOUNT):   len = length(vl{i});
MPRINT(TABCOUNT):   **vl{i} = substr(vl{i},1,len) || " (" || put(0,&pctfmt) || "%)";
MPRINT(TABCOUNT):   vl{i} = substr(vl{i},1,len);
MPRINT(TABCOUNT):   drop len;
MPRINT(TABCOUNT):   end;
MPRINT(TABCOUNT):   end;
MPRINT(TABCOUNT):   drop i;
MPRINT(TABCOUNT):   length pvalc1 pvalc2 $10;
MPRINT(TABCOUNT):   pvalc1='';
MPRINT(TABCOUNT):   pvalc2='';
