MPRINT(MAIN):  ;
MPRINT(MAIN):   data combine;
MPRINT(MAIN):   set combine;
MPRINT(MAIN):   length _newlbl $80;
MPRINT(MAIN):   select (sortord);
MPRINT(MAIN):   when (1) _newlbl = 'Any TEAE';
MPRINT(MAIN):   when (2) _newlbl = 'TEAE with Grade 3 or Higher';
MPRINT(MAIN):   when (3) _newlbl = 'TEAE with Grade 2 or Higher';
MPRINT(MAIN):   when (4) _newlbl = 'TEAE Related to Study Drug';
MPRINT(MAIN):   when (5) _newlbl = 'TEAE Related to Study Drug with Grade 3 or Higher';
MPRINT(MAIN):   when (6) _newlbl = 'TEAE Related to Study Drug with Grade 2 or Higher';
MPRINT(MAIN):   when (7) _newlbl = 'TE Serious AE';
MPRINT(MAIN):   when (8) _newlbl = 'TE Serious AE Related to Study Drug';
MPRINT(MAIN):   when (9) _newlbl = 'TEAE Leading to Discontinuation of Study Drug';
MPRINT(MAIN):   when (10) _newlbl = 'TEAE Leading to Dose Interruption of Study Drug';
MPRINT(MAIN):   when (11) _newlbl = 'TEAE Leading to Dose Reduction of Study Drug';
MPRINT(MAIN):   when (12) _newlbl = 'TEAE Leading to Discontinuation of Study';
MPRINT(MAIN):   when (13) _newlbl = 'TEAE Leading to Death';
MPRINT(MAIN):   otherwise _newlbl = ' ';
MPRINT(MAIN):   end;
                                                                    The SAS System

MPRINT(MAIN):   if _newlbl ne ' ' then linlabel = _newlbl;
MPRINT(MAIN):   drop _newlbl;
MPRINT(MAIN):   run;

