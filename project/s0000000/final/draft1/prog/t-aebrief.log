MPRINT(TABCOUNT):   sortord=7;
MPRINT(TABCOUNT):   type = "PTCT";
MPRINT(TABCOUNT):   level = 1;
MPRINT(TABCOUNT):   array vl {*} value1 - value3;
MPRINT(TABCOUNT):   if trim(start) eq '.' or start = ' ' then delete;
MPRINT(TABCOUNT):   do i = 1 to 3;
MPRINT(TABCOUNT):   if vl{i} = ' ' then do;
