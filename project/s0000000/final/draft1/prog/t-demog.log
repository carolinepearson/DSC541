MPRINT(TABDCAT):   * proc print data = _tabcat3 (obs=100);
MPRINT(TABDCAT):   * title "Macro tabdcat: File _tabcat3 after calc deniminator";
MPRINT(TABDCAT):   * run;
MPRINT(TABDCAT):   *----------------------------------------;
MPRINT(TABDCAT):   * Percents without missing ;
MPRINT(TABDCAT):   * numbers in denominator ;
MPRINT(TABDCAT):   *----------------------------------------;
MPRINT(TABDCAT):   *** Total patient count variable, used for calculating cell percents ***;
MPRINT(TABDCAT):   **********************************************************************;
MPRINT(TABDCAT):   *** Recalculate the counts without the missings ***;
MPRINT(TABDCAT):   *** if MISSPCT requested (print missings as a category) ***;
MPRINT(TABDCAT):   *** and NOMISSPC requested (do not use missings in the denominator ***;
MPRINT(TABDCAT):   **********************************************************************;
MPRINT(TABDCAT):   ***************************************************************************;
MPRINT(TABDCAT):   *** test: if n = 100 pct for any subgroup and then skip the calculation ***;
MPRINT(TABDCAT):   *** for cilevelw ***;
MPRINT(TABDCAT):   ***************************************************************************;
MPRINT(TABDCAT):   ******************************************;
MPRINT(TABDCAT):   *** put together the display data set ***;
MPRINT(TABDCAT):   ******************************************;
MPRINT(TABDCAT):   data _tabcat4;
MPRINT(TABDCAT):   length statval statval2 statval3 $40 start $200 linlabel $250;
MPRINT(TABDCAT):   set _tabcat3;
MPRINT(TABDCAT):   by trt01pn;
MPRINT(TABDCAT):   array tmpvarn len;
MPRINT(TABDCAT):   array tmpvarc $ statval statval2 statval3 linlabel;
MPRINT(TABDCAT):   retain totcount;
MPRINT(TABDCAT):   if first.trt01pn then totcount = 0;
MPRINT(TABDCAT):   if nomisspc^='Y' then totcount + count;
MPRINT(TABDCAT):   start = left(put(ethnicn,best.));
MPRINT(TABDCAT):   linlabel = left(put(ethnicn,FETHNICN.));
MPRINT(TABDCAT):   if trim(linlabel) = '.' or linlabel = ' ' then linlabel = '- Missing -';
MPRINT(TABDCAT):   pct = percent;
MPRINT(TABDCAT):   *** NOMISSPC=Y only calculate cellpct if pct is not missing ***;
MPRINT(TABDCAT):   if (pct ne .) then cellpct = 100*(count/100);
MPRINT(TABDCAT):   else cellpct = .;
MPRINT(TABDCAT):   statval = ' ';
MPRINT(TABDCAT):   statval = put(count, 3. );
MPRINT(TABDCAT):   *** If coldenom requested, show N as N/COLUMN TOTAL ***;
                                                                    The SAS System

MPRINT(TABDCAT):   len = length(statval);
MPRINT(TABDCAT):   *** NOMISSPC=Y only format the nonmissings ***;
MPRINT(TABDCAT):   if (pct ne .) then do;
MPRINT(TABDCAT):   *** Display "0" or "0.0" as "<1" or "<0.1" ***;
MPRINT(TABDCAT):   drop tmppct;
MPRINT(TABDCAT):   tmppct = 10**-1;
MPRINT(TABDCAT):   *** Normal case = percent=0 or is >= threshold ***;
MPRINT(TABDCAT):   if(pct eq 0 or pct>=tmppct) then statval = substr(statval,1,len) || " (" || put(pct,5.1) || "%)";
MPRINT(TABDCAT):   *** Number between 0 and lowest displayable value ***;
MPRINT(TABDCAT):   else statval = substr(statval,1,len) || " ( <" || put(tmppct,3.1) || "%)";
MPRINT(TABDCAT):   end;
MPRINT(TABDCAT):   if misspct ='N' then delete;
MPRINT(TABDCAT):   * delete missing cat if not used in rpt;
MPRINT(TABDCAT):   * if nomisspc='Y' then delete;
MPRINT(TABDCAT):   * delete missing cat if not part of calculations;
MPRINT(TABDCAT):   drop len ethnicn misspct;
MPRINT(TABDCAT):   run;

