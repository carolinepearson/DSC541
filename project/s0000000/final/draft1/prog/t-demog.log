MPRINT(UNIVAR):   *----------------------------------------------------------------------------;
MPRINT(UNIVAR):   * If geometric mean or ci is requested, check for negative value in &var ;
MPRINT(UNIVAR):   *----------------------------------------------------------------------------;
MPRINT(UNIVAR):   data _tabcon1;
MPRINT(UNIVAR):   set _tabcon0;
MPRINT(UNIVAR):   length statval $ 40 linlabel $250 statord $ 40;
MPRINT(UNIVAR):   statord = '1';
MPRINT(UNIVAR):   linlabel = 'N';
MPRINT(UNIVAR):   statval = ' ';
MPRINT(UNIVAR):   if (n>.) then statval = put(n, 5. );
MPRINT(UNIVAR):   output;
                                                                    The SAS System

MPRINT(UNIVAR):   *** Special clause, used to prevent some means from ***;
MPRINT(UNIVAR):   *** being printed as "-0.00", just show as "0.00" ***;
MPRINT(UNIVAR):   *** if n=0, then statval had carried through at 0 also ***;
MPRINT(UNIVAR):   *** force it to be missing ***;
MPRINT(UNIVAR):   statord = '2';
MPRINT(UNIVAR):   linlabel = "Mean (SD)";
MPRINT(UNIVAR):   statval = ' ';
MPRINT(UNIVAR):   if (n>0) then do;
MPRINT(UNIVAR):   statval = left(put( round(mean,10**(-1*1)), 8.1 ));
MPRINT(UNIVAR):   if abs(input(statval,??best.)) eq 0 then do;
MPRINT(UNIVAR):   statval = left(put( 0, 8.1 ));
MPRINT(UNIVAR):   end;
MPRINT(UNIVAR):   end;
MPRINT(UNIVAR):   if (n>1) then do;
MPRINT(UNIVAR):   statval = trim(statval) || ' (' || trim(left(put(round(sd,10**(-1*2)), 8.2 ))) || ')';
MPRINT(UNIVAR):   end;
MPRINT(UNIVAR):   output;
MPRINT(UNIVAR):   statord = '6';
MPRINT(UNIVAR):   linlabel = 'Median';
MPRINT(UNIVAR):   statval = ' ';
MPRINT(UNIVAR):   if (n>0) then do;
MPRINT(UNIVAR):   **if median^=. then statval = trim(put(median, &_statlenc..&meddec ));
MPRINT(UNIVAR):   if median^=. then statval = trim(put(round(median, 10**(-1*1)), 8.1 ));
MPRINT(UNIVAR):   if abs(input(statval,??best.)) eq 0 then statval = left(put(0, 8.1 ));
MPRINT(UNIVAR):   end;
MPRINT(UNIVAR):   output;
MPRINT(UNIVAR):   statord = '7';
MPRINT(UNIVAR):   linlabel = 'Q1, Q3';
MPRINT(UNIVAR):   statval = ' ';
MPRINT(UNIVAR):   if (n>0) then do;
MPRINT(UNIVAR):   statval = trim(put(round(qone,10**(-1*1)), 8.1 ))|| ', ' || left(put(round(qthre,10**(-1*1)),8.1));
MPRINT(UNIVAR):   end;
MPRINT(UNIVAR):   output;
MPRINT(UNIVAR):   statord = '8';
MPRINT(UNIVAR):   linlabel = 'Min, Max';
MPRINT(UNIVAR):   statval = ' ';
MPRINT(UNIVAR):   if (n>0) then do;
MPRINT(UNIVAR):   statval = trim(put(round(min,10**(-1*1)), 8.1 )) || ', ' || left(put(round(max,10**(-1*1)),8.1 ));
MPRINT(UNIVAR):   end;
MPRINT(UNIVAR):   output;
MPRINT(UNIVAR):   ***************************************************;
MPRINT(UNIVAR):   ** add change-from-baseline p-value if requested **;
MPRINT(UNIVAR):   ***************************************************;
MPRINT(UNIVAR):   run;

