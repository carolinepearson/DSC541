MPRINT(TABDCONT):   * Get variable information from dataset - abort if it is not there ;
MPRINT(TABDCONT):   *----------------------------------------------------------------------------;
MPRINT(TABDCONT):   data _null_;
MPRINT(TABDCONT):   length label1 label2 $250;
MPRINT(TABDCONT):   ds = open("analf","i");
MPRINT(TABDCONT):   var = varnum(ds , "bwt");
MPRINT(TABDCONT):   if not(var) then do;
MPRINT(TABDCONT):   call symput("_errcode","F");
MPRINT(TABDCONT):   call symput("_errmsg","Continuous analysis variable bwt .does not. exist - canceling run" );
MPRINT(TABDCONT):   end;
MPRINT(TABDCONT):   else do;
MPRINT(TABDCONT):   label1 = varlabel(ds,var);
MPRINT(TABDCONT):   if index(label1,'~') > 0 then do;
MPRINT(TABDCONT):   label2 = scan(label1,2,'~');
MPRINT(TABDCONT):   label1 = scan(label1,1,'~');
MPRINT(TABDCONT):   end;
MPRINT(TABDCONT):   call symput("label1",label1);
                                                                    The SAS System

MPRINT(TABDCONT):   call symput("label2",label2);
MPRINT(TABDCONT):   end;
MPRINT(TABDCONT):   *** Check stratification variables ***;
MPRINT(TABDCONT):   run;

