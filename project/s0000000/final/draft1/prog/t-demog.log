MPRINT(UNIVAR):   proc univariate data=analf NOPRINT;
MPRINT(UNIVAR):   by trt01pn ;
MPRINT(UNIVAR):   var bwt;
MPRINT(UNIVAR):   output out=_tabcon0 n = n mean = mean median = median stdmean = stdmean std = sd q1 = qone q3 = qthre min = min max = max var = var 
t = t probt = probt probm = probm probs = probs msign = msign signrank = signrank cv = cv ;
