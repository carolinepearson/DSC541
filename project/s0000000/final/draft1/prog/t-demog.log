MPRINT(PVALUE):   else if (_tmp_value<0.0001) then pvalc1 ='<0.0001';
MPRINT(PVALUE):   else pvalc1 = put( _tmp_value, 6.4);
MPRINT(PVALUE):   end;
MPRINT(PVALUE):   run;

