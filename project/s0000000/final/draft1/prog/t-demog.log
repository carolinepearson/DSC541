MPRINT(PVALUE):   data _tabcon2;
MPRINT(PVALUE):   set _tabcon2;
MPRINT(PVALUE):   drop _tmp_value;
MPRINT(PVALUE):   format pvalc1 $8.;
MPRINT(PVALUE):   label pvalc1= 'p-value';
MPRINT(PVALUE):   if (missing(pval1)) then pvalc1 = 'N/A';
MPRINT(PVALUE):   else do;
MPRINT(PVALUE):   _tmp_value = pval1;
MPRINT(PVALUE):   if (_tmp_value<0 or _tmp_value>1) then pvalc1 = 'ER'||'ROR';
MPRINT(PVALUE):   else if (_tmp_value<0.0001) then pvalc1 ='<0.0001';
MPRINT(PVALUE):   else pvalc1 = put( _tmp_value, 6.4);
MPRINT(PVALUE):   end;
MPRINT(PVALUE):   run;

