MPRINT(TABDCONT):   data _tabcon2 (drop=value: rename=( _val_1=value1 _val_2=value2 _val_3=value3));
MPRINT(TABDCONT):   length label1 label2 $250 _val_1 - _val_3 $ 40;
MPRINT(TABDCONT):   set _tabcon2;
MPRINT(TABDCONT):   array _val {*} $ value1 - value3;
MPRINT(TABDCONT):   array nval {*} $ _val_1 - _val_3;
MPRINT(TABDCONT):   do __i = 1 to 3;
MPRINT(TABDCONT):   nval[__i] = _val[__i];
MPRINT(TABDCONT):   if (compress(linlabel)='N' and nval[__i] = '') then nval[__i] = '    0';
MPRINT(TABDCONT):   end;
MPRINT(TABDCONT):   type = "CONT";
MPRINT(TABDCONT):   sortord = 6;
MPRINT(TABDCONT):   label1 = "Weight (kg)                                                                                                             
