MPRINT(TABDCAT):   if not(var) then do;
MPRINT(TABDCAT):   call symput("_errcode","F");
MPRINT(TABDCAT):   call symput("_errmsg","Categorical analysis variable sexn .does not. exist - canceling run" );
MPRINT(TABDCAT):   end;
MPRINT(TABDCAT):   else do;
