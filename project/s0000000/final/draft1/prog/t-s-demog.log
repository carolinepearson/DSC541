MPRINT(UNIVAR):   if abs(input(statval,??best.)) eq 0 then do;
MPRINT(UNIVAR):   statval = left(put( 0, 8.0 ));
MPRINT(UNIVAR):   end;
MPRINT(UNIVAR):   end;
MPRINT(UNIVAR):   if (n>1) then do;
MPRINT(UNIVAR):   statval = trim(statval) || ' (' || trim(left(put(round(sd,10**(-1*1)), 8.1 ))) || ')';
MPRINT(UNIVAR):   end;
MPRINT(UNIVAR):   output;
MPRINT(UNIVAR):   statord = '6';
