MPRINT(UNIVAR):   if median^=. then statval = trim(put(round(median, 10**(-1*0)), 8.0 ));
MPRINT(UNIVAR):   if abs(input(statval,??best.)) eq 0 then statval = left(put(0, 8.0 ));
MPRINT(UNIVAR):   end;
MPRINT(UNIVAR):   output;
MPRINT(UNIVAR):   statord = '7';
MPRINT(UNIVAR):   linlabel = 'Q1, Q3';
MPRINT(UNIVAR):   statval = ' ';
