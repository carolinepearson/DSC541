MPRINT(UNIVAR):   statval = trim(put(round(qone,10**(-1*0)), 8.0 ))|| ', ' || left(put(round(qthre,10**(-1*0)),8.0));
MPRINT(UNIVAR):   end;
MPRINT(UNIVAR):   output;
MPRINT(UNIVAR):   statord = '8';
