         <MethodDef OID="MT.ADAE.TRTEMFL" Name="Algorithm to derive ADAE.TRTEMFL"
                    Type="Computation">
            <Description>
               <TranslatedText>If ASTDT &gt;= TRTSDT &gt; . then TRTEMFL='Y'. Otherwise TRTEMFL='N'</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADAE.AOCC02FL" Name="Algorithm to derive ADAE.AOCC02FL"
                    Type="Computation">
            <Description>
               <TranslatedText>Subset to TRTEMFL='Y' and AESER='Y' and sort by Subject (USUBJID), Start Date (ASTDT), and Sequence Number (AESEQ) and flag the first record (set AOCC02FL=?Y?) within each Subject</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADAE.AOCC03FL" Name="Algorithm to derive ADAE.AOCC03FL"
                    Type="Computation">
            <Description>
               <TranslatedText>Subset to TRTEMFL='Y' and AESER='Y' and sort by Subject (USUBJID), System Organ Class (AEBODSYS), Start Date (ASTDT), and Sequence Number (AESEQ) and flag the first record (set AOCC03FL=?Y?) within each Subject and SOC</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADAE.AOCC04FL" Name="Algorithm to derive ADAE.AOCC04FL"
                    Type="Computation">
            <Description>
               <TranslatedText>Subset to TRTEMFL='Y' and AESER='Y' and sort by Subject (USUBJID), System Organ Class (AEBODSYS), Preferred Term (AEDECOD), Start Date (ASTDT), and Sequence Number (AESEQ) and flag the first record (set AOCC04FL=?Y?) within each Subject, SOC, and PT</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.SAFFL" Name="Algorithm to derive ADSL.SAFFL" Type="Computation">
            <Description>
               <TranslatedText>Y if ITTFL='Y' and TRTSDT ne missing. N otherwise</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRT01A" Name="Algorithm to derive ADSL.TRT01A" Type="Computation">
            <Description>
               <TranslatedText>TRT01A=TRT01P, i.e., no difference between actual and randomized treatment in this study.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRT01AN" Name="Algorithm to derive ADSL.TRT01AN"
                    Type="Computation">
            <Description>
               <TranslatedText>Numeric code for TRT01A which corresponds to the randomized dose</TranslatedText>
            </Description>
         </MethodDef>
