         </CodeList>
         <CodeList OID="CL.YN" Name="No Yes Response" DataType="text"
                   def:StandardOID="STD.SDTM 2020-12-18">
            <CodeListItem CodedValue="N" OrderNumber="1">
               <Decode>
                  <TranslatedText>No</TranslatedText>
               </Decode>
               <Alias Name="C49487" Context="nci:ExtCodeID"/>
            </CodeListItem>
            <CodeListItem CodedValue="Y" OrderNumber="2">
               <Decode>
                  <TranslatedText>Yes</TranslatedText>
               </Decode>
               <Alias Name="C49488" Context="nci:ExtCodeID"/>
            </CodeListItem>
            <Alias Name="C66742" Context="nci:ExtCodeID"/>
         </CodeList>
         <MethodDef OID="MT.ADSL.SAFFL" Name="Algorithm to derive ADSL.SAFFL" Type="Computation">
            <Description>
               <TranslatedText>Y if ITTFL='Y' and TRTSDT ne missing. N otherwise</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.ITTFL" Name="Algorithm to derive ADSL.ITTFL" Type="Computation">
            <Description>
               <TranslatedText>Y if ARMCD ne ' '. N otherwise</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.RANDFL" Name="Algorithm to derive ADSL.RANDFL" Type="Computation">
            <Description>
               <TranslatedText>Y if ARMCD ne ' '. N otherwise</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.PPROTFL" Name="Algorithm to derive ADSL.PPROTFL"
                    Type="Computation">
            <Description>
               <TranslatedText>Y if SAFFL='Y' and subject met all protocol defined criterias. N otherwise</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRT01PN" Name="Algorithm to derive ADSL.TRT01PN"
                    Type="Computation">
            <Description>
               <TranslatedText>Numeric code for TRT01P which corresponds to the randomized dose</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRT01A" Name="Algorithm to derive ADSL.TRT01A" Type="Computation">
            <Description>
               <TranslatedText>TRT01A=TRT01P, i.e., no difference between actual and randomized treatment in this study.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRT01AN" Name="Algorithm to derive ADSL.TRT01AN"
                    Type="Computation">
            <Description>
               <TranslatedText>Numeric code for TRT01A which corresponds to the randomized dose</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRTSDT" Name="Algorithm to derive ADSL.TRTSDT" Type="Computation">
            <Description>
               <TranslatedText>SV.SVSTDTC when SV.VISITNUM=3, converted to SAS date</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRTEDT" Name="Algorithm to derive ADSL.TRTEDT" Type="Computation">
            <Description>
               <TranslatedText>The date of final dose (from the CRF) is EX.EXENDTC on the subject's last EX record. If the date of final dose is missing for the subject and the subject discontinued after visit 3, use the date of discontinuation as the date of last dose. Convert the date to a SAS date.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRTDUR" Name="Algorithm to derive ADSL.TRTDUR" Type="Computation">
            <Description>
               <TranslatedText>TRTEDT-TRTSDT+1</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRTDURM" Name="Algorithm to derive ADSL.TRTDURM"
                    Type="Computation">
            <Description>
               <TranslatedText>if TRTDURD NE . then TRTDURM=round(TRTDURD/30, 0.01);</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRTDURM1" Name="Algorithm to derive ADSL.TRTDURM1"
                    Type="Computation">
            <Description>
               <TranslatedText>if 0&lt;TRTDURM&lt;1 then TRTDURM1=&lt;1 month
else if TRTDURM&gt;=1 then TRTDURM1=&gt;=1 month</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRTDURM2" Name="Algorithm to derive ADSL.TRTDURM2"
                    Type="Computation">
            <Description>
               <TranslatedText>if TRTDURM&gt;=3 then TRTDURM2=&gt;=3 month</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRTDURM3" Name="Algorithm to derive ADSL.TRTDURM3"
                    Type="Computation">
            <Description>
               <TranslatedText>if TRTDURM&gt;=6 then TRTDURM3=&gt;=6 month</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.ADSL.TRTDURM4" Name="Algorithm to derive ADSL.TRTDURM4"
                    Type="Computation">
            <Description>
               <TranslatedText>if TRTDURM&gt;=12 then TRTDURM4=&gt;=12 month</TranslatedText>
            </Description>
         </MethodDef>
