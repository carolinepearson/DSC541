{
  "openapi": "3.1.0",
  "info": {
    "title": "Weather API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://wttr.in"
    }
  ],
  "paths": {
    "/{location}": {
      "get": {
        "operationId": "GetCurrentWeather",
        "description": "Get current weather for a city.",
        "parameters": [
          {
            "name": "location",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "default": "j1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Weather data returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}